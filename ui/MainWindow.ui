  <property name="styleSheet">
   <string notr="true">/* Estilo base para todos los botones */
QPushButton {
    background-color: #2c3e50; /* Azul noche elegante */
    color: #ffffff;
    border: 2px solid #34495e;
    border-radius: 15px; /* Bordes bien redondeados */
    padding: 10px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
}

/* Efecto al pasar el ratón por encima (Hover) */
QPushButton:hover {
    background-color: #34495e;
    border: 2px solid #3498db; /* Borde celeste brillante */
    color: #ecf0f1;
}

/* Efecto al hacer clic (Pressed) */
QPushButton:pressed {
    background-color: #2980b9;
    border: 2px solid #2980b9;
    padding-top: 12px; /* Simula que el botón se hunde */
    padding-bottom: 8px;
}

/* --- MAGIA ESPECÍFICA PARA EL BOTÓN DE SALIR --- */
QPushButton#btnSalir {
    background-color: #c0392b; /* Rojo oscuro */
    border: 2px solid #e74c3c;
}

QPushButton#btnSalir:hover {
    background-color: #e74c3c; /* Rojo brillante */
    border: 2px solid #ff7979;
}

QPushButton#btnSalir:pressed {
    background-color: #a5281b;
    border: 2px solid #a5281b;
}</string>
