       <layout class="QVBoxLayout" name="verticalLayout_reglas">
        <item>
         <widget class="QLabel" name="lblTituloReglas">
          <property name="font">
           <font>
            <pointsize>20</pointsize>
            <bold>true</bold>
           </font>
          </property>
          <property name="styleSheet">
           <string>color: white; background-color: rgba(0,0,0,150); padding: 10px; border-radius: 10px;</string>
          </property>
          <property name="text">
           <string>Reglas del Juego</string>
          </property>
          <property name="alignment">
